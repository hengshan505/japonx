#!name=金融风控优化增强模块
#!desc=银行证券支付类App直连，降低代理环境风控概率
#!author=ChatGPT
#!homepage=https://github.com


####################################################
# 真实IP解析
# 防止Fake-IP导致金融App异常
####################################################

[General]

always-real-ip = %APPEND%

# 银行
*.icbc.com.cn,
*.ccb.com,
*.abchina.com,
*.boc.cn,
*.bankcomm.com,
*.cmbchina.com,
*.cmbc.com.cn,

# 银联
*.unionpay.com,
*.95516.com,


# 支付
*.alipay.com,
*.alipayobjects.com,
*.tenpay.com,
*.wechat.com,
*.weixin.qq.com,


# 证券
*.eastmoney.com,
*.10jqka.com.cn,
*.htsc.com.cn,
*.citics.com,
*.cjis.cn,
*.gtja.com,
*.cmschina.com.cn,
*.gf.com.cn



####################################################
# 绕过Surge VPN处理
# 比DIRECT更接近真实网络
####################################################

skip-proxy = %APPEND%

# 银行

*.icbc.com.cn,
*.ccb.com,
*.abchina.com,
*.boc.cn,
*.bankcomm.com,
*.cmbchina.com,
*.cmbc.com.cn,


# 银联

*.unionpay.com,
*.95516.com,


# 支付宝

*.alipay.com,
*.alipayobjects.com,


# 微信支付

*.wechat.com,
*.weixin.qq.com,
*.tenpay.com,


# 证券

*.eastmoney.com,
*.10jqka.com.cn,
*.htsc.com.cn,
*.citics.com,
*.gtja.com,
*.cmschina.com.cn,
*.gf.com.cn



####################################################
# 规则
####################################################

[Rule]


############################
# 银行
############################

DOMAIN-SUFFIX,icbc.com.cn,DIRECT
DOMAIN-SUFFIX,ccb.com,DIRECT
DOMAIN-SUFFIX,abchina.com,DIRECT
DOMAIN-SUFFIX,boc.cn,DIRECT
DOMAIN-SUFFIX,bankcomm.com,DIRECT
DOMAIN-SUFFIX,cmbchina.com,DIRECT
DOMAIN-SUFFIX,cmbc.com.cn,DIRECT


############################
# 银联
############################

DOMAIN-SUFFIX,unionpay.com,DIRECT
DOMAIN-SUFFIX,95516.com,DIRECT


############################
# 支付
############################

DOMAIN-SUFFIX,alipay.com,DIRECT
DOMAIN-SUFFIX,alipayobjects.com,DIRECT

DOMAIN-SUFFIX,tenpay.com,DIRECT
DOMAIN-SUFFIX,wechat.com,DIRECT
DOMAIN-SUFFIX,weixin.qq.com,DIRECT


############################
# 证券
############################

DOMAIN-SUFFIX,eastmoney.com,DIRECT
DOMAIN-SUFFIX,10jqka.com.cn,DIRECT
DOMAIN-SUFFIX,htsc.com.cn,DIRECT
DOMAIN-SUFFIX,citics.com,DIRECT
DOMAIN-SUFFIX,gtja.com,DIRECT
DOMAIN-SUFFIX,cmschina.com.cn,DIRECT
DOMAIN-SUFFIX,gf.com.cn,DIRECT


############################
# 政务/实名系统
############################

DOMAIN-SUFFIX,gov.cn,DIRECT
DOMAIN-SUFFIX,chinatax.gov.cn,DIRECT
DOMAIN-SUFFIX,12306.cn,DIRECT


############################
# 国内公共服务
############################

DOMAIN-SUFFIX,qq.com,DIRECT
DOMAIN-SUFFIX,aliyuncs.com,DIRECT
DOMAIN-SUFFIX,alicdn.com,DIRECT
DOMAIN-SUFFIX,tencent.com,DIRECT



############################
# 默认
############################

FINAL,PROXY
