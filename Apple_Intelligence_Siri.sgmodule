#!name=Apple Intelligence & Siri 分流优化
#!desc=Siri 核心语音服务直连并使用真实 IP，避免代理或 Fake-IP 导致 Siri 报错。
#!system=ios

[General]
skip-proxy = %APPEND% guzzoni.apple.com
always-real-ip = %APPEND% guzzoni.apple.com, *.guzzoni.apple.com, *.siri.apple.com

[Rule]
# Siri 核心语音服务：必须直连
DOMAIN-SUFFIX,guzzoni.apple.com,DIRECT
DOMAIN-SUFFIX,siri.apple.com,DIRECT
DOMAIN,dejavu.apple.com,DIRECT
DOMAIN,sequoia.apple.com,DIRECT
DOMAIN-SUFFIX,smoot.apple.com,DIRECT

# Apple Intelligence：私有云计算及地区资格校验
DOMAIN,gspe1-ssl.ls.apple.com,智能助理
DOMAIN-SUFFIX,apple-relay.apple.com,智能助理
DOMAIN-SUFFIX,apple-relay.cloudflare.com,智能助理
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,智能助理
DOMAIN-SUFFIX,apple-relay.akamaized.net,智能助理
DOMAIN-SUFFIX,cp4.cloudflare.com,智能助理

# ChatGPT / OpenAI
DOMAIN-SUFFIX,openai.com,智能助理
DOMAIN-SUFFIX,chatgpt.com,智能助理
